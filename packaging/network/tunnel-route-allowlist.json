{
  "schema": "pf07.tunnel-route-allowlist.v1",
  "classification": "PUBLIC_TUNNEL_ROUTE_POLICY",
  "public_routes": [
    {"match": "exact", "path": "/", "purpose": "storefront home and WooCommerce query actions"},
    {"match": "prefix", "path": "/shop", "purpose": "storefront catalog"},
    {"match": "prefix", "path": "/product", "purpose": "storefront product detail"},
    {"match": "prefix", "path": "/cart", "purpose": "storefront cart"},
    {"match": "prefix", "path": "/checkout", "purpose": "synthetic non-payment checkout"},
    {"match": "prefix", "path": "/order-received", "purpose": "synthetic order result"},
    {"match": "prefix", "path": "/wp-content/plugins/oddroom-orderops/assets/", "purpose": "OFFSET storefront static assets"},
    {"match": "prefix", "path": "/wp-content/plugins/woocommerce/assets/", "purpose": "WooCommerce storefront static assets"},
    {"match": "prefix", "path": "/wp-content/themes/twentytwentyfive/assets/", "purpose": "reviewed theme fonts and static assets"},
    {"match": "prefix", "path": "/wp-includes/js/", "purpose": "WordPress browser JavaScript"},
    {"match": "prefix", "path": "/wp-includes/css/", "purpose": "WordPress browser styles"},
    {"match": "prefix", "path": "/wp-includes/images/", "purpose": "WordPress browser images"},
    {"match": "prefix", "path": "/wp-includes/fonts/", "purpose": "WordPress browser fonts"},
    {"match": "prefix", "path": "/wp-admin", "purpose": "WordPress-authenticated administrator routes"},
    {"match": "exact", "path": "/wp-login.php", "purpose": "WordPress authentication entry"},
    {"match": "prefix", "path": "/wp-json/wc/store/", "purpose": "WooCommerce storefront API"}
  ],
  "denied_routes": [
    {"match": "prefix", "path": "/.pf07", "surface": "package-local state"},
    {"match": "prefix", "path": "/n8n", "surface": "internal automation editor"},
    {"match": "prefix", "path": "/metrics", "surface": "operational metrics"},
    {"match": "prefix", "path": "/evidence", "surface": "private evidence"},
    {"match": "prefix", "path": "/logs", "surface": "runtime logs"},
    {"match": "prefix", "path": "/docker", "surface": "container API"},
    {"match": "prefix", "path": "/my-account", "surface": "disabled customer account entry"},
    {"match": "prefix", "path": "/wp-json/wc/store/v1/cart/update-customer", "surface": "customer profile mutation"},
    {"match": "prefix", "path": "/wp-json/wc/store/cart/update-customer", "surface": "customer profile mutation"},
    {"match": "prefix", "path": "/wp-json/wc/store/v1/checkout", "surface": "unused Store API checkout mutation"},
    {"match": "prefix", "path": "/wp-json/wc/store/checkout", "surface": "unused Store API checkout mutation"},
    {"match": "prefix", "path": "/wp-json/wc/store/v1/batch", "surface": "batched Store API mutation"},
    {"match": "prefix", "path": "/wp-json/wc/store/batch", "surface": "batched Store API mutation"},
    {"match": "prefix", "path": "/wp-content/plugins/oddroom-orderops/tests/", "surface": "package test harnesses"},
    {"match": "prefix", "path": "/wp-content/", "surface": "unreviewed WordPress content or executable code"},
    {"match": "prefix", "path": "/wp-includes/", "surface": "unreviewed WordPress runtime code"},
    {"match": "prefix", "path": "/wp-json/", "surface": "non-storefront WordPress REST APIs"},
    {"match": "exact", "path": "/wp-cron.php", "surface": "internal scheduler entry"},
    {"match": "prefix", "path": "/server-status", "surface": "server diagnostics"}
  ],
  "public_ports": ["HTTPS_TUNNEL_PROVIDER_ASSIGNED"],
  "non_public_services": ["MariaDB", "n8n", "Docker API", "task runner broker", "launcher hub", "evidence", "logs", "metrics"]
}
